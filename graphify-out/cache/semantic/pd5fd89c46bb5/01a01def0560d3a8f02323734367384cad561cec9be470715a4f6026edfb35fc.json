{"nodes": [{"id": "claude_motor_decisao_compra", "label": "Motor de Decis\u00e3o de Compra", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_simulador", "label": "Simulador (centro do sistema)", "file_type": "rationale", "rationale": "O produto n\u00e3o \u00e9 o modelo de previs\u00e3o, e sim a decis\u00e3o de quantidade \u2014 a prova de valor \u00e9 financeira. Por isso o simulador \u00e9 o centro do sistema, n\u00e3o o modelo: constr\u00f3i-se o simulador primeiro, com previs\u00e3o ing\u00eanua no lugar, e troca-se o modelo depois sem tocar em mais nada.", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_forecaster", "label": "Protocol Forecaster", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_decisioncontext", "label": "DecisionContext (dataclass)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_policy", "label": "Protocol Policy", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_tabelas_canonicas", "label": "Tabelas can\u00f4nicas (sales, items, suppliers, stock)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_erp_baseline", "label": "Pol\u00edtica erp_baseline", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_basestock", "label": "Pol\